{
  "name": "cafe",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "daemon": "node packages/cli/src/main.ts daemon run",
    "cafe": "node packages/cli/src/main.ts",
    "build:web": "npm run build --workspace @cafe/web",
    "release:build": "node scripts/build-release.mjs",
    "release:pack": "node scripts/build-release.mjs && node -e \"require('fs').mkdirSync('release-out',{recursive:true})\" && npm pack ./release --pack-destination release-out",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
